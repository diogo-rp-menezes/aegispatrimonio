# Example environment variables for local development (DO NOT commit secrets in real repos)
# Copy to .env and fill in real values. All variables below are REQUIRED.

# Database (matches docker-compose service names)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/aegis-patrimonio?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Server
SERVER_PORT=8080

# JWT (REQUIRED - application fails to start without it)
# Use a strong base64 secret (at least 256 bits). Do NOT commit real secrets.
# Example generation: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=28800000

# Docker-compose override example
# When running locally with docker-compose, you may point to the 'db' service
# or use localhost when running the DB directly on your machine.

# FRONTEND
VITE_API_BASE_URL=http://localhost:8080/api

